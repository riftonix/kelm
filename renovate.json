{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated CI dependency pins",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n\\s*[A-Z][A-Z0-9_]*:\\s*(?<currentValue>v?[0-9][^\\s]*)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n\\s*[A-Z][A-Z0-9_]*:\\s*github\\.com/[^@\\s]+@(?:[^\\s]*/)?(?<currentValue>v?[0-9][^/\\s]*)"
      ]
    }
  ]
}
